{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@effect-state-tree/react-todo-example",
  "projectType": "application",
  "sourceRoot": "apps/react-todo-example/src",
  "tags": ["scope:effect-state-tree", "type:example-app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "color": true,
        "command": "vite build --config vite.config.ts",
        "cwd": "apps/react-todo-example"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "color": true,
        "command": "vite --config vite.config.ts",
        "cwd": "apps/react-todo-example"
      }
    },
    "dev:server": {
      "executor": "nx:run-commands",
      "options": {
        "color": true,
        "command": "bun src/server/main.ts",
        "cwd": "apps/react-todo-example"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [{ "projects": "self", "target": "build" }],
      "options": {
        "color": true,
        "command": "vite preview --config vite.config.ts",
        "cwd": "apps/react-todo-example"
      }
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "color": true,
        "command": "playwright test --config playwright.config.ts",
        "cwd": "apps/react-todo-example"
      }
    },
    "format": {},
    "format:check": {},
    "lint": {},
    "lint:fix": {},
    "test:unit": {},
    "typecheck": {}
  }
}
