{
  "name": "@effect-state-tree/history",
  "version": "0.1.0",
  "description": "Undo, redo, grouping, limits, and attached history state for effect-state-tree commits.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/run4w4y/effect-state-tree.git",
    "directory": "packages/history"
  },
  "homepage": "https://github.com/run4w4y/effect-state-tree#readme",
  "bugs": {
    "url": "https://github.com/run4w4y/effect-state-tree/issues"
  },
  "keywords": [
    "effect",
    "state-tree",
    "typescript",
    "undo-redo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
